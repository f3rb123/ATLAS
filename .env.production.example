ATLAS_HOST=atlas.example.invalid
ATLAS_BIND_IP=127.0.0.1
ATLAS_HTTPS_PORT=443
ATLAS_EXTERNAL_URL=https://atlas.example.invalid
ATLAS_ENV=production
# Empty = no explicit provider domain pin, but private/reserved addresses still blocked.
ATLAS_PROVIDER_ALLOWLIST=[]
ATLAS_PROVIDER_LOCAL_ALLOWLIST=[]
# Keep secrets in .runtime/secrets files, generated locally; never commit them.
