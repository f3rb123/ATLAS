# syntax=docker/dockerfile:1
ARG PYTHON_IMAGE=python@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
FROM ${PYTHON_IMAGE} AS build
WORKDIR /app
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY requirements.lock ./
RUN --mount=type=secret,id=proxy_ca,target=/run/proxy-ca.pem \
    if [ -f /run/proxy-ca.pem ]; then export PIP_CERT=/run/proxy-ca.pem; fi; \
    pip install --no-cache-dir --require-hashes -r requirements.lock
COPY atlas atlas
COPY pyproject.toml ./
RUN pip install --no-deps --no-build-isolation .
FROM ${PYTHON_IMAGE}
RUN --mount=type=tmpfs,target=/etc/ssl/certs --mount=type=secret,id=proxy_ca,target=/usr/local/share/ca-certificates/cloud-proxy.crt \
    if [ -f /usr/local/share/ca-certificates/cloud-proxy.crt ]; then update-ca-certificates; fi; \
    apt-get update && apt-get install -y --no-install-recommends bubblewrap git && rm -rf /var/lib/apt/lists/* && useradd -u 10001 -m atlas
COPY --from=build /opt/venv /opt/venv
WORKDIR /app
COPY --chown=10001:10001 atlas atlas
COPY --chown=10001:10001 migrations migrations
COPY --chown=10001:10001 alembic.ini ./
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
ENTRYPOINT ["python","-m","atlas.container_entry"]
CMD ["uvicorn","atlas.api:app","--host","0.0.0.0","--port","8000","--no-access-log"]
