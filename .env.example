ATLAS_DATABASE_URL=sqlite:///.runtime/atlas.db
ATLAS_EXTERNAL_URL=http://localhost:8000
ATLAS_ENV=development
ATLAS_MASTER_KEY_FILE=.runtime/master.key
ATLAS_REDIS_URL=redis://localhost:6379/0

# Raw provider key files are selected explicitly, never parsed as dotenv.
# ATLAS_PROVIDER_KEY_FILE=/absolute/private/path/hackerai.key
ATLAS_GLOBAL_TOKEN_CAP=50000000
ATLAS_TOKEN_ALLOCATION=2000000
ATLAS_VALIDATION_TOKEN_RESERVE=200000
ATLAS_PROVIDER_TIMEOUT_SECONDS=90
ATLAS_GATEWAY_TIMEOUT_SECONDS=150
ATLAS_WORKER_CONCURRENCY=8
ATLAS_REQUIRE_MFA=false
